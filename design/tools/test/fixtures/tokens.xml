<?xml version="1.0" encoding="UTF-8"?>
<!--
  Flipova Foundation Design Tokens
  =================================
  Namespace: urn:flipova:foundation:registry
  Schema: flipova.foundation/registry/1
  Schema Location: schema.xsd
  Register: tokens

  PURPOSE:
  Design tokens are the atomic values of the design system.
  They define spacing, colors, typography, shadows, animations, etc.

  TOKEN KINDS:
  - scale: Numeric scale values (spacing, radii, font sizes)
  - map: Named values without a scale (z-index, opacity)
  - font: Font family definitions with platform variants
  - color: Color palette with shades
  - shadow: Shadow definitions with offset, blur, color
  - animation: Duration and easing definitions
-->
