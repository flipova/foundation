<?xml version="1.0" encoding="UTF-8"?>
<!--
  Flipova Foundation Themes
  ==========================
  Namespace: urn:flipova:foundation:registry
  Schema: flipova.foundation/registry/1
  Schema Location: schema.xsd
  Register: themes
  Default: light

  PURPOSE:
  A theme maps semantic roles to color token references. The role ids are the
  gluestack-ui / nativewind CSS variable names (the part after the two-dash
  prefix), so the design registry and the runtime theme config speak the same
  language: generate.py turns this file into the CSS variables of
  components/ui/gluestack-ui-provider/config.ts.

  ROLE NAMING:
  A role id is a CSS variable name without its two-dash prefix, e.g. the role
  "background" drives the obvious variable, "card-foreground" pairs with
  "card", "primary-foreground" with "primary", and so on (including the
  "success" / "warning" / "error" / "info" status pairs).
-->
