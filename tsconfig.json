{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./foundation/*"],
      "@flipova/foundation": ["./foundation/index.ts"],
      "@flipova/foundation/*": ["./foundation/*"],
      "@flipova/foundation/web": ["./foundation/web/index.ts"]
    }
  },
  "include": ["foundation", "docs"],
  "exclude": ["node_modules", "dist", "**/*.example.ts"]
}