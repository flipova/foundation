{
  "name": "@flipova/foundation",
  "version": "1.11.0",
  "description": "Design tokens, theming system, and layout primitives for React Native (iOS, Android, Web)",
  "author": "Flipova",
  "license": "MIT",
  "workspaces": [
    ".",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/flipova/foundation.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs",
      "require": "./dist/tokens/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.mjs",
      "require": "./dist/theme/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.mjs",
      "require": "./dist/registry/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.mjs",
      "require": "./dist/ui/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.mjs",
      "require": "./dist/config/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "flipova": "./dist/cli/flipova.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "ui:generate": "npx tsx scripts/generate.ts",
    "registry:validate": "npx tsx scripts/validate-defs.ts",
    "registry:add": "npx tsx scripts/registry-cli.ts add",
    "registry:remove": "npx tsx scripts/registry-cli.ts remove",
    "registry:generate": "npx tsx scripts/generate-registry.ts",
    "theme:add": "npx tsx scripts/theme-cli.ts add",
    "theme:remove": "npx tsx scripts/theme-cli.ts remove",
    "theme:generate": "npx tsx scripts/generate-themes.ts",
    "build": "npm run registry:generate && tsup",
    "dev": "npm run ui:generate && tsup --watch",
    "docs:sync": "npx tsx scripts/docs-capture.ts",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && npm run typecheck && changeset publish",
    "version": "changeset version",
    "prepublishOnly": "npm run build && npm run typecheck",
    "ds": "npx tsx scripts/design-system-cli.ts",
    "tokens:generate": "npx tsx scripts/generate-tokens.ts"
  },
  "peerDependencies": {
    "expo": ">=55.0.0",
    "expo-camera": ">=15.0.0",
    "expo-haptics": ">=13.0.0",
    "expo-linear-gradient": ">=12.0.0",
    "expo-navigation-bar": ">=3.0.0",
    "expo-router": ">=55.0.0",
    "expo-status-bar": ">=2.0.0",
    "lucide-react-native": ">=0.300.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-screens": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-linear-gradient": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-status-bar": {
      "optional": true
    },
    "expo-navigation-bar": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    },
    "expo-camera": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-screens": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@craftzdog/react-native-buffer": "^6.1.2",
    "@expo/metro-runtime": "^56.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/prompts": "^2.4.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "expo": "^56.0.11",
    "expo-blur": "^57.0.0",
    "expo-camera": "^55.0.13",
    "expo-haptics": "^55.0.11",
    "expo-linear-gradient": "^12.0.0",
    "expo-navigation-bar": "^55.0.10",
    "expo-router": "^56.2.10",
    "expo-status-bar": "^55.0.5",
    "expo-video": "^57.0.0",
    "fast-check": "^4.6.0",
    "happy-dom": "^20.10.6",
    "js-yaml": "^5.2.1",
    "jsdom": "^29.1.1",
    "lottie-react": "^2.4.1",
    "lottie-react-native": "^7.3.8",
    "lucide-react-native": "^1.7.0",
    "prompts": "^2.4.2",
    "react-dom": "^19.2.7",
    "react-native": "^0.86.0",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-maps": "^1.29.0",
    "react-native-reanimated": "^3.19.5",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^14.0.1",
    "readable-stream": "^4.7.0",
    "ts-morph": "^28.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "react-native",
    "design-system",
    "design-tokens",
    "theming",
    "layout",
    "ui",
    "flipova",
    "expo"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-picker/picker": "^2.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo-audio": "^57.0.2",
    "expo-document-picker": "^57.0.1",
    "expo-image": "^57.0.1",
    "expo-image-picker": "^57.0.4",
    "expo-web-browser": "^57.0.1",
    "immer": "^10.1.1",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "qrcode": "^1.5.4",
    "react": ">=18.0.0",
    "react-native-worklets-core": "^1.6.3",
    "reanimated-color-picker": "^5.1.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.5"
  }
}
