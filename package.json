{
  "name": "@flipova/foundation",
  "version": "2.4.4",
  "description": "Foundation of the Flipova design system: a provider-agnostic UI contract (57 components), five providers (flipova, gluestack, reusables, paper, tamagui), and a registry-driven theming toolchain with a local GUI.",
  "author": "Flipova",
  "license": "MIT",
  "workspaces": [
    "."
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flipova/foundation.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "browser": "./dist/ui/index.js",
      "import": "./dist/ui/index.mjs",
      "require": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "browser": "./dist/contract/index.js",
      "import": "./dist/contract/index.mjs",
      "require": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "browser": "./dist/providers/index.js",
      "import": "./dist/providers/index.mjs",
      "require": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./providers/flipova": {
      "types": "./dist/providers/flipova/index.d.ts",
      "browser": "./dist/providers/flipova/index.js",
      "import": "./dist/providers/flipova/index.mjs",
      "require": "./dist/providers/flipova/index.js",
      "default": "./dist/providers/flipova/index.js"
    },
    "./providers/gluestack": {
      "types": "./dist/providers/gluestack/index.d.ts",
      "browser": "./dist/providers/gluestack/index.js",
      "import": "./dist/providers/gluestack/index.mjs",
      "require": "./dist/providers/gluestack/index.js",
      "default": "./dist/providers/gluestack/index.js"
    },
    "./providers/gluestack/ui": {
      "types": "./dist/providers/gluestack/ui/index.d.ts",
      "browser": "./dist/providers/gluestack/ui/index.js",
      "import": "./dist/providers/gluestack/ui/index.mjs",
      "require": "./dist/providers/gluestack/ui/index.js",
      "default": "./dist/providers/gluestack/ui/index.js"
    },
    "./providers/paper": {
      "types": "./dist/providers/paper/index.d.ts",
      "browser": "./dist/providers/paper/index.js",
      "import": "./dist/providers/paper/index.mjs",
      "require": "./dist/providers/paper/index.js",
      "default": "./dist/providers/paper/index.js"
    },
    "./providers/tamagui": {
      "types": "./dist/providers/tamagui/index.d.ts",
      "browser": "./dist/providers/tamagui/index.js",
      "import": "./dist/providers/tamagui/index.mjs",
      "require": "./dist/providers/tamagui/index.js",
      "default": "./dist/providers/tamagui/index.js"
    },
    "./providers/reusables": {
      "types": "./dist/providers/reusables/index.d.ts",
      "browser": "./dist/providers/reusables/index.js",
      "import": "./dist/providers/reusables/index.mjs",
      "require": "./dist/providers/reusables/index.js",
      "default": "./dist/providers/reusables/index.js"
    },
    "./tokens": {
      "types": "./components/providers/gluestack/ui/gluestack-ui-provider/tokens.d.ts",
      "require": "./components/providers/gluestack/ui/gluestack-ui-provider/tokens.js",
      "default": "./components/providers/gluestack/ui/gluestack-ui-provider/tokens.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "flipova-design": "design/tools/cli.js"
  },
  "files": [
    "dist",
    "components",
    "!components/**/*.test.ts",
    "!components/**/*.test.tsx",
    "!components/providers/class-resolver.ts",
    "design",
    "!design/tools/test",
    "COMPONENTS.md",
    "DOCS.md",
    "CHANGES.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck",
    "deploy": "npm view $npm_package_name@$npm_package_version version >/dev/null 2>&1 || npm publish --provenance --access public",
    "boundary": "node scripts/check-boundary.js",
    "boundary:test": "node --test scripts/boundary.test.js",
    "docs:check": "node scripts/check-docs.js",
    "docs:test": "node --test scripts/docs.test.js",
    "test": "npm run design:test && npm run boundary:test && npm run boundary && npm run docs:test && npm run docs:check && vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "design:gen": "node design/tools/cli.js gen",
    "design:gen:check": "node design/tools/cli.js gen --check",
    "design:gen:list": "node design/tools/cli.js gen --list",
    "design:check": "node design/tools/cli.js check",
    "design:check:list-rules": "node design/tools/cli.js check --list-rules",
    "design:verify": "node design/tools/cli.js verify",
    "design:canonical": "node design/tools/cli.js canonical",
    "design:lint": "node design/tools/cli.js lint",
    "design:pipeline": "node design/tools/cli.js pipeline",
    "design:test": "node --test design/tools/test/*.test.js",
    "components:doc": "UPDATE_COMPONENTS_DOC=1 vitest run components/alignment.test.ts",
    "ci:verify": "node scripts/ci-verify.js",
    "ci:deliver": "npm run deploy --"
  },
  "peerDependencies": {
    "@rn-primitives/switch": ">=1.0.0",
    "@tamagui/core": ">=3.0.0",
    "expo": ">=55.0.0",
    "expo-glass-effect": ">=55.0.0",
    "lucide-react": ">=0.400.0",
    "nativewind": ">=4.1.23",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-paper": ">=5.15.0"
  },
  "peerDependenciesMeta": {
    "@rn-primitives/switch": {
      "optional": true
    },
    "@tamagui/core": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-glass-effect": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "nativewind": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native-paper": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@react-native/assets-registry": "^0.88.0",
    "@rn-primitives/switch": "^1.5.2",
    "@tamagui/core": "^3.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.72.8",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "expo-glass-effect": "^57.0.4",
    "fast-check": "^4.6.0",
    "happy-dom": "21.0.4",
    "js-yaml": "^5.2.1",
    "jsdom": "^30.1.3",
    "lottie-react": "^2.4.1",
    "nativewind": "^4.2.7",
    "postcss": "^8.5.28",
    "prettier": "^3.3.0",
    "prompts": "^2.4.2",
    "react-dom": "^19.3.0",
    "react-native-paper": "^5.15.4",
    "readable-stream": "^4.8.0",
    "tailwindcss": "^3.4.19",
    "ts-morph": "^28.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "uuid": "^14.0.2",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "expo",
    "flipova",
    "gluestack",
    "layout",
    "nativewind",
    "react-native",
    "react-native-paper",
    "tamagui",
    "theming",
    "ui"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@expo/html-elements": "^0.12.5",
    "@gluestack-ui/core": "^4.0.0-alpha.0",
    "@gluestack-ui/utils": "^5.0.6",
    "@gluestack/ui-next-adapter": "^4.0.0-alpha.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@legendapp/motion": "^2.5.3",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@react-native-community/datetimepicker": "^9.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csstype": "^3.2.3",
    "dom-helpers": "^6.0.1",
    "immer": "^10.1.1",
    "lucide-react": ">=0.400.0",
    "motion": "^12.40.0",
    "qrcode": "^1.5.4",
    "react": ">=18.0.0",
    "react-aria": "^3.52.1",
    "react-native-gesture-handler": "^2.33.0",
    "react-native-reanimated": "^3.19.5",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.19.13",
    "react-stately": "^3.50.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^0.1.20",
    "zustand": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "homepage": "https://github.com/flipova/foundation#readme",
  "bugs": {
    "url": "https://github.com/flipova/foundation/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
