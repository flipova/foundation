{
  "name": "@flipova/foundation",
  "version": "2.2.0",
  "description": "gluestack-ui components for React Native (iOS, Android) and Web, with a registry-driven theming pipeline (XML tokens/themes to gluestack config + Tailwind theme)",
  "author": "Flipova",
  "license": "MIT",
  "workspaces": [
    "."
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flipova/foundation.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "browser": "./dist/ui/index.js",
      "import": "./dist/ui/index.mjs",
      "require": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./tokens": {
      "types": "./components/ui/gluestack-ui-provider/tokens.d.ts",
      "require": "./components/ui/gluestack-ui-provider/tokens.js",
      "default": "./components/ui/gluestack-ui-provider/tokens.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "flipova-design": "design/tools/npm.js"
  },
  "files": [
    "dist",
    "components",
    "design",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && npm run typecheck && changeset publish",
    "release:ci": "node .github/scripts/publish.mjs",
    "version": "changeset version",
    "version:bump": "changeset version && node .github/scripts/flow.mjs release reset && npm run design:doc",
    "prepublishOnly": "npm run build && npm run typecheck",
    "docs": "npm run design:doc",
    "docs:build": "npm --prefix docs run build",
    "flow": "node .github/scripts/flow.mjs",
    "maintain": "node .github/scripts/maintain.mjs",
    "test": "vitest run",
    "design:gen": "node design/tools/design.js gen",
    "design:gen:check": "node design/tools/design.js gen --check",
    "design:gen:list": "node design/tools/design.js gen --list",
    "design:check": "node design/tools/design.js check",
    "design:check:list-rules": "node design/tools/design.js check --list-rules",
    "design:verify": "node design/tools/design.js verify",
    "design:canonical": "node design/tools/design.js canonical",
    "design:lint": "node design/tools/design.js lint",
    "design:doc": "node design/tools/design.js doc",
    "design:run": "node design/tools/design.js run",
    "design:edit": "node design/tools/design.js edit",
    "design:pipeline": "npm run design:gen && npm run design:check && npm run design:verify && npm run design:lint && npm run design:doc"
  },
  "peerDependencies": {
    "expo": ">=55.0.0",
    "expo-glass-effect": ">=55.0.0",
    "lucide-react": ">=0.400.0",
    "nativewind": ">=4.1.23",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-glass-effect": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@react-native/assets-registry": "^0.79.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/prompts": "^2.4.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.72.8",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.6.1",
    "expo-glass-effect": "^57.0.4",
    "fast-check": "^4.6.0",
    "happy-dom": "^20.10.6",
    "js-yaml": "^5.2.1",
    "jsdom": "^29.1.1",
    "lottie-react": "^2.4.1",
    "nativewind": "^4.2.7",
    "postcss": "^8.5.28",
    "prompts": "^2.4.2",
    "react-dom": "^19.3.0",
    "readable-stream": "^4.7.0",
    "tailwindcss": "^3.4.19",
    "ts-morph": "^28.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0",
    "uuid": "^14.0.2",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "react-native",
    "design-system",
    "design-tokens",
    "theming",
    "layout",
    "ui",
    "flipova",
    "expo"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@expo/html-elements": "^0.12.5",
    "@gluestack-ui/core": "^4.0.0-alpha.0",
    "@gluestack-ui/utils": "^4.0.0-alpha.0",
    "@gluestack/ui-next-adapter": "^4.0.0-alpha.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@legendapp/motion": "^2.5.3",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@react-native-community/datetimepicker": "^9.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csstype": "^3.2.3",
    "dom-helpers": "^5.2.1",
    "immer": "^10.1.1",
    "lucide-react": ">=0.400.0",
    "motion": "^12.40.0",
    "qrcode": "^1.5.4",
    "react": ">=18.0.0",
    "react-aria": "^3.52.1",
    "react-native-gesture-handler": "^2.33.0",
    "react-native-reanimated": "^3.19.5",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.19.13",
    "react-stately": "^3.50.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^0.1.20",
    "zustand": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
